        <!-- Process Description Box -->
        <mxCell id="deposit-notes" value="Проблемы текущего процесса:&#xa;• Обработка занимает 20-60 минут в зависимости от статуса клиента&#xa;• Ручной расчет ставок в Excel ежедневно&#xa;• Email-коммуникации между отделами&#xa;• Клиент должен физически прийти в отделение&#xa;• Нет возможности открыть депозит онлайн&#xa;• Разделение доступа между отделами создает задержки&#xa;• Интеграция АБС с кол-центром через БД (хрупкая)" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;" vertex="1" parent="deposit-section">
          <mxGeometry x="40" y="370" width="650" height="130" as="geometry" />
        </mxCell>

        <mxCell id="deposit-integration-notes" value="Типы интеграций:&#xa;━━━━ Прямое взаимодействие&#xa;- - - - - Интеграция через БД&#xa;━ ━ ━ Email (ручной процесс)" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;" vertex="1" parent="deposit-section">
